# ClassSpace Environment Configuration Template
# Default mode is local DEMO MODE (zero AWS cost, in-browser mock persistence).
# To test Live AWS Mode after deploying `infra/`, copy to `.env.local` and replace placeholders.
# NEVER put AWS credentials, secret keys, client secrets, or private keys in VITE_* variables.

# API Gateway HTTP API endpoint from CDK output `HttpApiEndpoint`
VITE_API_BASE_URL=https://api.example.invalid

# Amazon Cognito Public SPA Configuration (PKCE S256, GenerateSecret=false)
VITE_COGNITO_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=ap-south-1_PLACEHOLDER
VITE_COGNITO_CLIENT_ID=placeholder_client_id
VITE_COGNITO_DOMAIN=https://classspace-dev-auth.auth.ap-south-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback

# Campus configuration
VITE_CAMPUS_TIMEZONE=Asia/Kolkata
VITE_DEMO_MODE=true
